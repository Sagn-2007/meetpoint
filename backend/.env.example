# MeetPoint Configuration Example

# Environment mode: development, test, production
MEETPOINT_ENVIRONMENT=development

# CORS Configuration
# In production, provide explicit comma-separated origins. Wildcards (*) are forbidden with credentials.
# MEETPOINT_CORS_ORIGINS=https://meetpoint.example.com,https://app.meetpoint.example.com
MEETPOINT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (PostgreSQL)
# Local development default:
MEETPOINT_DATABASE_URL=postgresql+asyncpg://meetpoint:meetpoint@localhost:5432/meetpoint
MEETPOINT_SYNC_DATABASE_URL=postgresql+psycopg2://meetpoint:meetpoint@localhost:5432/meetpoint
# Optional SSL configuration for managed clouds (e.g., "require" for Neon):
MEETPOINT_DATABASE_SSL=

# Rate Limiting Configuration
MEETPOINT_RATE_LIMIT_ENABLED=true
# Comma-separated upstream trusted proxy IPs/CIDRs (e.g. Cloudflare IP ranges or local reverse proxy)
MEETPOINT_TRUSTED_PROXIES=127.0.0.1,::1
MEETPOINT_RATE_LIMIT_SESSION_CREATE=15
MEETPOINT_RATE_LIMIT_INVITATION_LOOKUP=60
MEETPOINT_RATE_LIMIT_JOIN=30
MEETPOINT_RATE_LIMIT_OPTIMIZE=10
MEETPOINT_RATE_LIMIT_LOCATION=60

# Collaborative Sessions & Security
MEETPOINT_SESSION_EXPIRATION_HOURS=24
MEETPOINT_SESSION_CLEANUP_INTERVAL_MINUTES=15
MEETPOINT_SESSION_RETENTION_HOURS=48
MEETPOINT_INVITATION_CODE_LENGTH=8
MEETPOINT_WS_AUTH_TIMEOUT_SECONDS=5.0

# Geographic Bounds & Safety Safeguards
MEETPOINT_MAX_BBOX_DIAMETER_KM=80.0
MEETPOINT_MAX_PARTICIPANT_PAIRWISE_DISTANCE_KM=75.0

# Memory and Disk Caching
MEETPOINT_MAX_IN_MEMORY_GRAPHS=8
MEETPOINT_ENABLE_DISK_CACHE=true

# Engine & Optimization Defaults
MEETPOINT_DEFAULT_NETWORK_TYPE=walk
MEETPOINT_DEFAULT_TOP_K=5
MEETPOINT_MAX_TOP_K=20
MEETPOINT_OVERPASS_TIMEOUT=60
MEETPOINT_LOG_LEVEL=INFO
