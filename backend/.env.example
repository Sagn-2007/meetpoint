# MeetPoint Backend Configuration
MEETPOINT_DEFAULT_NETWORK_TYPE=walk
MEETPOINT_ENABLE_DISK_CACHE=true
MEETPOINT_LOG_LEVEL=INFO
MEETPOINT_OVERPASS_TIMEOUT=60

# Database Configuration (PostgreSQL)
MEETPOINT_DATABASE_URL=postgresql+asyncpg://meetpoint:meetpoint@localhost:5432/meetpoint
MEETPOINT_SYNC_DATABASE_URL=postgresql+psycopg2://meetpoint:meetpoint@localhost:5432/meetpoint
MEETPOINT_SESSION_EXPIRATION_HOURS=24
MEETPOINT_INVITATION_CODE_LENGTH=8
